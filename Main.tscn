[node name="HowToPlay" type="Label" parent="MainMenu/Tutorials"]
layout_mode = 0
offset_left = 13.0
offset_top = 256.0
offset_right = 327.0
offset_bottom = 539.0
text = "HOW TO PLAY:

- Collect ingredients scattered around the house to complete recipes!
- Deposit the ingredients and recipes collected in the kitchen (starting point) to score.
- Hit other players by pressing E to steal and stun them!
- The player with the biggest score by the end of three rounds wins!"
autowrap_mode = 3

[node name="Rounds" type="Label" parent="MainMenu/Tutorials"]
layout_mode = 0
offset_left = 340.0
offset_top = 256.0
offset_right = 637.0
offset_bottom = 513.0
text = "ROUNDS:

- Every match is composed of three rounds of (time limit) seconds.
- Whenever the timer hits zero, a new round starts, with a new randomly selected recipe and new ingredients.
- Any ingredients and recipes not delivered by the end of the round will not count towards scoring!"
autowrap_mode = 3

[node name="Recipes" type="Label" parent="MainMenu/Tutorials"]
layout_mode = 0
offset_left = 653.0
offset_top = 256.0
offset_right = 950.0
offset_bottom = 513.0
text = "RECIPES:

- Every round there will be a new recipe chosen by random.
- The ingredients in the level will correspond to the current recipe.
- Delivering a full recipe will earn you double the points as from the standalone ingredients!"
autowrap_mode = 3

